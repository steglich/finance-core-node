{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": ["RULES.md", "AGENTS.md"],
  "permission": {
    "edit": "allow",
    "write": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "read": "allow",
    "skill": "allow",
    "question": "allow",
    "grep": "allow",
    "todowrite": "allow"
  },
  "tools": {
    "write": true,
    "bash": true,
    "webfetch": true,
    "edit": true,
    "read": true,
    "websearch": true,
    "skill": true,
    "question": true,
    "grep": true,
    "todowrite": true
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".vscode/**",
      "**/.opencode/**",
      ".claude/**",
      ".idea/**",
      ".history/**",
      "**/*.log",
      "**/*.lock",
      "config/**",
      "models/**",
      "seeders/**",
      "migrations/**"
    ]
  },
  "provider": {
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai",
        "apiKey": "ENV:OPENROUTER_API_KEY"
      },
      "models": {
        "deepseek/deepseek-v4-flash": {
          "tools": true
        },
        "qwen/qwen3-coder-flash": {
          "tools": true
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "laguna-xs-1m:latest": {
          "temperature": true,
          "options": {
            "temperature": 0.3,
            "num_ctx": 256000,
            "num_thread": 8,
            "repeat_penalty": 1.1,
            "num_predict": -1,
            "top_p": 0.85,
            "top_k": 40
          }
        },
        "laguna-xs-2.1-256k:latest": {
          "temperature": true,
          "options": {
            "temperature": 0.3,
            "num_ctx": 256000,
            "num_thread": 8,
            "repeat_penalty": 1.1,
            "num_predict": -1,
            "top_p": 0.85,
            "top_k": 40
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "Você é o agente de build do Finance Core — um dev sênior especialista em Node.js e TypeScript. Siga rigorosamente as instruções em AGENTS.md (já carregadas no contexto). Regras essenciais: (1) nunca assuma — pergunte se tiver dúvida, (2) sempre valide inputs com Zod, (3) trate todos os erros, (4) use Context7 MCP para documentação de bibliotecas antes de usá-las, (5) código limpo com funções pequenas, (6) código testável com dependências injetadas, (7) mantenha consistência com código existente, (8) nunca adicione dependências sem aprovação. Sempre use imports com extensão `.js` (projeto ESM com module nodenext).",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "grep": true,
        "glob": true,
        "task": true,
        "todowrite": true
      }
    }
  },
  "formatter": {
    "prettier": {
      "disabled": true
    },
    "custom-prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "environment": {
        "NODE_ENV": "development"
      },
      "extensions": [".js", ".ts", ".json"]
    }
  }
}
