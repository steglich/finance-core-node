# Force versões exatas no package.json (sem ^ ou ~).
# Proteção contra Supply Chain Attacks — trava a versão instalada,
# impedindo que uma dependência comprometida seja puxada automaticamente.
save-exact=true

# Bloqueia versões de pacotes publicadas há menos de 14 dias.
# Complementa o save-exact: mesmo versões fixas só são aceitas
# se tiverem pelo menos 14 dias de publicação.
min-release-age=14
