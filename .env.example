# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/finance_core

# Transport security for the database connection.
# `false` disables TLS entirely — only appropriate for a local database.
DATABASE_SSL=true
# `false` encrypts without verifying the server certificate. Needed for a
# managed database presenting a self-signed certificate; leave it unset
# wherever a trusted CA is available.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT — the secret must be at least 32 bytes or the server refuses to start.
JWT_SECRET=change-me-to-at-least-32-bytes-of-random
# Bind tokens to this deployment, so a token from another environment sharing
# the secret is not accepted here.
JWT_ISSUER=finance-core
JWT_AUDIENCE=finance-core-api

# Edge defenses
# Enable only behind a proxy that overwrites X-Forwarded-For. With no such
# proxy, a client could choose its own address and slip past the rate limit.
TRUST_PROXY=false
# Comma-separated origins allowed to make cross-origin browser calls.
# Empty or unset means no origin is allowed.
CORS_ORIGINS=http://localhost:5173
# Global rate limit, applied to every route.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# Stricter limit for /auth — every attempt costs a bcrypt verification.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute
